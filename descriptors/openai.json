{
  "$schema": "./package-descriptor.schema.json",
  "package_id": "openai",
  "factory": { "name": "create_openai", "sdk_name": "createOpenAI", "default_factory": "openai" },
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "base_url": { "type": "string", "description": "Default https://api.openai.com/v1; trailing slash removed." },
      "api_key": { "type": "string" },
      "organization": { "type": "string", "description": "Sent as OpenAI-Organization." },
      "project": { "type": "string", "description": "Sent as OpenAI-Project." },
      "headers": { "type": "object", "additionalProperties": { "type": ["string", "null"] }, "description": "null removes a header." },
      "name": { "type": "string" }
    }
  },
  "credential_fields": [
    { "field": "api_key", "default_env": "OPENAI_API_KEY", "sent_as": "authorization: Bearer", "empty_string": "used_as_given" }
  ],
  "runtime_handle_fields": [
    { "field": "fetch", "kind": "fetch" },
    { "field": "web_socket", "kind": "web_socket", "feature": "realtime" }
  ],
  "methods": {
    "list": [
      { "name": "chat", "kind": "language", "provider_suffix": "chat" },
      { "name": "completion", "kind": "language", "provider_suffix": "completion" },
      { "name": "responses", "kind": "language", "provider_suffix": "responses" },
      { "name": "embedding", "kind": "embedding", "provider_suffix": "embedding" },
      { "name": "image", "kind": "image", "provider_suffix": "image" },
      { "name": "speech", "kind": "speech", "provider_suffix": "speech" },
      { "name": "transcription", "kind": "transcription", "provider_suffix": "transcription" },
      { "name": "decision", "kind": "decision", "provider_suffix": null },
      { "name": "files", "kind": "files", "provider_suffix": "files" }
    ],
    "default_method": "responses"
  },
  "name_semantics": { "setting": "name", "default": "openai", "required": false, "note": "Prefix of every provider() string." },
  "provider_string_rules": {
    "template": "{name}.{method_suffix}",
    "examples": { "chat": "openai.chat", "responses": "openai.responses", "completion": "openai.completion" }
  },
  "provider_options_rules": { "namespaces": ["openai"], "unknown_fields": "dropped" },
  "tools": [
    "openai.apply_patch", "openai.code_interpreter", "openai.computer", "openai.custom", "openai.file_search",
    "openai.image_generation", "openai.local_shell", "openai.mcp", "openai.programmatic_tool_calling",
    "openai.web_search", "openai.web_search_preview"
  ],
  "extensions": { "discovery": true, "named": ["files", "decision"] },
  "auth": { "modes": ["bearer"], "offline_auth_recipe": "replay_fetch with a recorded exchange; no key or env is read during replay" },
  "catalogue_mapping": { "catalogue_provider_ids": ["openai"] },
  "audit_metadata": { "family": "openai", "protocol": "openai-chat+responses" },
  "supported_features": ["streaming", "tools", "structured_outputs", "reasoning", "images", "audio", "files"],
  "source_verification": {
    "sdk_package": "@ai-sdk/openai",
    "sdk_version": "4.0.83",
    "aimux_source": ["aimux-providers/src/openai/mod.rs:187", "aimux-providers/src/openai/mod.rs:239", "aimux-providers/src/openai/mod.rs:309-385"]
  }
}
